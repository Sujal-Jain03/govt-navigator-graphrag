# Govt Navigator UI image (Phase 10). Talks to the API over HTTP;
# it holds no model, no data and no keys.
# Build from the project root: docker build -f Dockerfile.ui -t govt-nav-ui .
FROM python:3.11-slim
WORKDIR /app
COPY requirements-ui.txt .
RUN pip install --no-cache-dir -r requirements-ui.txt
COPY ui/ ./ui/
EXPOSE 8501
CMD ["streamlit", "run", "ui/app.py", "--server.port", "8501", "--server.address", "0.0.0.0"]
